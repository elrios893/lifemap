#!/bin/bash
# cloud-init: instala Docker, clona el repo y levanta el sistema. Log: /var/log/lifemap-init.log
exec > >(tee -a /var/log/lifemap-init.log) 2>&1
set -euxo pipefail

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y ca-certificates curl git
curl -fsSL https://get.docker.com | sh
usermod -aG docker ubuntu
snap install aws-cli --classic

git clone --branch ${repo_branch} ${repo_url} /opt/lifemap
cd /opt/lifemap

cat > .env <<'EOF'
MONGO_USER=${mongo_user}
MONGO_PASSWORD=${mongo_password}
MONGO_DB=lifemap
NGROK_AUTHTOKEN=${ngrok_token}
NGROK_DOMAIN=${ngrok_domain}
S3_BUCKET=${s3_bucket}
S3_PREFIX=lifemap
JENKINS_ADMIN_PASSWORD=${jenkins_pw}
REPO_URL=${repo_url}
COMPOSE_PROFILES=${ngrok_token != "" ? "tunnel" : ""}
EOF
chmod 600 .env

GIT_COMMIT=$(git rev-parse HEAD) docker compose up -d --build

# Si hay respaldo en S3 (Mongo + modelos) se restaura solo; si no, queda el sistema vacío y se corre scripts/run_pipeline.sh.
export PATH=$PATH:/snap/bin
bash scripts/restore_from_s3.sh || echo "restauración falló: correr scripts/run_pipeline.sh"
echo "lifemap listo"
