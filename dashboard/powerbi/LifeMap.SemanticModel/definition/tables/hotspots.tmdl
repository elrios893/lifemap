table hotspots
	lineageTag: 31d2b04c-1320-5624-986f-47569bf4c1ac

	measure 'Hotspots (celdas)' = CALCULATE(COUNTROWS(hotspots), hotspots[hotspot] = TRUE())
		formatString: 0
		lineageTag: fa5c4f43-ef53-5367-9340-0cdc1201dac3

