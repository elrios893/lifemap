{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "v_evol",
  "position": {
    "x": 650,
    "y": 150,
    "z": 8000,
    "height": 280,
    "width": 610
  },
  "visual": {
    "visualType": "lineClusteredColumnComboChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "trend"
                    }
                  },
                  "Property": "ventana"
                }
              },
              "queryRef": "trend.ventana",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Aggregation": {
                  "Expression": {
                    "Column": {
                      "Expression": {
                        "SourceRef": {
                          "Entity": "trend"
                        }
                      },
                      "Property": "hotspots"
                    }
                  },
                  "Function": 0
                }
              },
              "queryRef": "Sum(trend.hotspots)"
            }
          ]
        },
        "Y2": {
          "projections": [
            {
              "field": {
                "Aggregation": {
                  "Expression": {
                    "Column": {
                      "Expression": {
                        "SourceRef": {
                          "Entity": "trend"
                        }
                      },
                      "Property": "pct_negative"
                    }
                  },
                  "Function": 0
                }
              },
              "queryRef": "Sum(trend.pct_negative)"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Evolución del % de reseñas negativas (línea) y hotspots (columnas)'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "12D"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}