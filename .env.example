# Copiar a .env (NO se versiona). En el servidor lo genera Terraform/cloud-init.
MONGO_USER=admin
MONGO_PASSWORD=cambia-esta-clave
MONGO_DB=lifemap

# Kaggle (token de la API). En Jenkins vive como credencial, nunca en el repo.
KAGGLE_USERNAME=
KAGGLE_KEY=

# ngrok (opcional): dominio estatico gratuito de https://dashboard.ngrok.com/domains
# Activar con COMPOSE_PROFILES=tunnel
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
COMPOSE_PROFILES=

# Bucket S3 persistente (la VM accede con rol de instancia, sin llaves)
S3_BUCKET=
S3_PREFIX=lifemap
